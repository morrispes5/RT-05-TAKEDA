# Overlay the API .env.example; NOT a complete deploy config and contains no secrets.
# Read docs/SHARED_HOSTING.md before activation. Keep DDL credentials OFF hosting.
RT05_DEPLOYMENT_PROFILE=shared
QUEUE_CONNECTION=database
RT05_OUTBOX_QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=file
RT05_HEARTBEAT_STORE=file
# Leave RT05_HEARTBEAT_MAX_AGE unset. Shared then allows 900s cron + 300s late grace.
# Setting 300 marks a healthy 15-minute cron as failed. Set it only to override that formula.
APP_DEBUG=false
# Resend HTTP avoids blocked SMTP ports. Do not switch until resend/resend-php is installed
# and a real inbox test passes. Until then keep the already-proven SMTP settings off this file.
# MAIL_MAILER=resend
# RESEND_API_KEY belongs in the private env, never in git.
# Supply APP_URL, APP_KEY, pooled DATABASE_URL, CA and mail secrets privately.
# Require DB_SSLMODE=verify-full and DB_SSLROOTCERT pointing at a valid CA bundle.
# Safety-net cron every 15 minutes. A one-minute cron is allowed; an idle tick does not query Neon.
# */15 * * * * cd /absolute/private/rest-api && /absolute/php artisan rt05:shared-tick >> /absolute/private/cron.log 2>&1
# pcntl is optional. With it, SIGALRM stops a job at the worker timeout.
# Without it, --timeout is 0 and --max-time only applies between jobs.
# SMTP/socket/statement_timeout/CPU limits are set instead; they do not kill a job stuck in GD.
# Rotate cron.log. Do not run schedule:work / queue daemons alongside shared-tick.
# Same-origin sketch: infra/shared/public-htaccess.example (not yet proven on the host).
MAIL_TIMEOUT=15
# Push M10: FCM HTTP v1 via Laravel HTTP + ext-openssl (no extra package, works on shared).
# Put the service-account JSON outside public_html and point FCM_CREDENTIALS_PATH at it,
# or set FCM_CREDENTIALS_BASE64 in the private env. Empty = inbox only.
# FCM_CREDENTIALS_PATH=/absolute/private/firebase-service-account.json
