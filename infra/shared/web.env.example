# Overlay website/.env.example untuk production (profil shared, M16). Tanpa secret; APP_KEY website berbeda dari API.
APP_ENV=production
APP_DEBUG=false
# Domain production pilihan pemilik (M16_PLAN K1). Dipakai untuk canonical, og:url, sitemap, dan robots.txt.
# APP_URL=https://<domain-production>
# Origin API yang sama (same-origin); website hanya membaca snapshot konten terbit.
# RT05_CONTENT_API=https://<domain-production>
# Hanya production yang boleh diindeks Google. Staging/preview: biarkan kosong (noindex + robots Disallow: /).
RT05_SEARCH_INDEXING=true
# Metadata APK dari workflow Mobile release APK. Kosong = public/unduh/versi.json (APK di public/unduh/).
# RT05_APK_META=
SESSION_DRIVER=file
CACHE_STORE=file
